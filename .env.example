# בסיס נתונים – PostgreSQL (ב-Vercel: Neon מתוך Vercel Marketplace)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/logisticwh"
# מחרוזת ישירה (Non-pooled) עבור prisma migrate – ב-Vercel/Neon נוצרת אוטומטית
DATABASE_URL_UNPOOLED=""

# מפתח חתימת Session – לפחות 32 תווים אקראיים. ליצירה: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# קוד הקמה ראשונית (דף /setup) – לפחות 16 תווים. פעיל רק כשאין משתמשים במערכת.
# מומלץ למחוק אחרי יצירת מנהל המרלו"ג הראשון.
SETUP_TOKEN=""

# שליחת מיילים (שלב 3) – SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="LogisticWH <no-reply@example.com>"

# Webhook לספק SMS (שלב 3)
SMS_WEBHOOK_URL=""
